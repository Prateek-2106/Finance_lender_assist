{
  "name": "vendorstreet",
  "version": "0.1.0",
  "description": "Multi-tenant platform for micro-businesses: website, lead capture, estimates, invoices, and funding risk assessment.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sms:simulate": "tsx scripts/simulate-sms.ts",
    "fixtures": "tsx fixtures/write.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "e2e": "playwright test",
    "build:server": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "build": "npm run web:build && npm run build:server",
    "infra:synth": "npm --prefix infra run synth",
    "infra:deploy": "npm --prefix infra run deploy",
    "infra:destroy": "npm --prefix infra run destroy"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "csv-parse": "^7.0.3",
    "express": "^5.2.1",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.0.14",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
